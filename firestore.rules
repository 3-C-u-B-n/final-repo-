rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Pillar 2: Validation Blueprint for UserProfile
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('savedCount' in data) || data.savedCount is number) &&
             (!('favoritePalettes' in data) || (data.favoritePalettes is list && data.favoritePalettes.size() <= 50));
    }

    // User collection: Private profile per user
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId);
    }

    // Pillar 2 & 8: Validation Blueprint for SavedOutfit
    function isValidSavedOutfit(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             data.garmentId is string && data.garmentId.size() > 0 && data.garmentId.size() <= 50 &&
             data.colorId is string && data.colorId.size() > 0 && data.colorId.size() <= 50 &&
             (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
             (!('authorPhoto' in data) || (data.authorPhoto is string && data.authorPhoto.size() <= 500)) &&
             (!('gender' in data) || (data.gender in ['female', 'male'])) &&
             (!('occasionId' in data) || (data.occasionId is string && data.occasionId.size() <= 50)) &&
             (!('fabricId' in data) || (data.fabricId is string && data.fabricId.size() <= 50)) &&
             (!('customColorHex' in data) || (data.customColorHex is string && data.customColorHex.size() <= 25)) &&
             (!('customPantHex' in data) || (data.customPantHex is string && data.customPantHex.size() <= 25)) &&
             (!('headpieceId' in data) || (data.headpieceId is string && data.headpieceId.size() <= 50)) &&
             (!('jewelryId' in data) || (data.jewelryId is string && data.jewelryId.size() <= 50)) &&
             (!('handheldId' in data) || (data.handheldId is string && data.handheldId.size() <= 50)) &&
             (!('footwearId' in data) || (data.footwearId is string && data.footwearId.size() <= 50)) &&
             (!('backgroundId' in data) || (data.backgroundId is string && data.backgroundId.size() <= 50)) &&
             (!('visualEffect' in data) || (data.visualEffect is string && data.visualEffect.size() <= 50)) &&
             (!('windSpeed' in data) || (data.windSpeed is string && data.windSpeed.size() <= 50)) &&
             (!('lighting' in data) || (data.lighting is string && data.lighting.size() <= 50)) &&
             (!('harmonyScore' in data) || (data.harmonyScore is number && data.harmonyScore >= 0.0 && data.harmonyScore <= 10.0)) &&
             (!('traditionStatus' in data) || (data.traditionStatus is string && data.traditionStatus.size() <= 30)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1000)) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('likesCount' in data) || data.likesCount is number) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /savedOutfits/{outfitId} {
      allow get: if resource.data.isPublic == true || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || resource.data.isPublic == true;
      allow create: if isSignedIn() && isValidId(outfitId) && isValidSavedOutfit(incoming());
      allow update: if isSignedIn() && isValidId(outfitId) && resource.data.userId == request.auth.uid && 
                    isValidSavedOutfit(incoming()) && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(outfitId) && resource.data.userId == request.auth.uid;
    }
  }
}
